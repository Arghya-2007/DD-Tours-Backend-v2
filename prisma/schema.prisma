// 1. Setup
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 2. USER MODEL
// ==========================================
model User {
  // Your requirements
  userId       String    @id @default(uuid()) // Random Alphanumeric
  userName     String
  userEmail    String    @unique
  password     String // Hashed
  phoneNumber  String
  aadharNumber String?
  dob          DateTime?

  // 🆕 NEW FIELD: User Address
  userAddress String? @db.Text

  // System fields
  role      Role     @default(USER) // USER or ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings Booking[]
  reviews  Review[]
  blogs    Blog[]
}

enum Role {
  USER
  ADMIN
}

// ==========================================
// 3. TOURS MODEL
// ==========================================
model Tour {
  // Your requirements
  tourId          String @id @default(uuid())
  tourTitle       String
  slug            String @unique
  tourDuration    String
  tourDescription String @db.Text
  tourPrice       Float

  // 🆕 NEW FIELDS (Location & Category)
  // Made optional (?) to prevent migration errors with existing data
  startLocation String? // e.g., "Kolkata", "Delhi"
  tourCategory  String? // e.g., "Adventure", "Relaxation"

  // Date Logic
  expectedMonth   String?
  isFixedDate     Boolean   @default(false)
  fixedDate       DateTime?
  bookingDeadline DateTime?

  // Arrays
  coveredPlaces String[]
  includedItems String[]
  images        String[]

  // Status & Seats
  tourStatus     TourStatus @default(UPCOMING)
  maxSeats       Int
  availableSeats Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings Booking[]
}

enum TourStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

// ==========================================
// 4. BOOKING MODEL
// ==========================================
model Booking {
  bookingId String @id @default(uuid())

  // Relations
  user   User   @relation(fields: [userId], references: [userId])
  userId String
  tour   Tour   @relation(fields: [tourId], references: [tourId])
  tourId String

  // Booking Info
  totalGuests Int
  totalPrice  Float
  bookingDate DateTime @default(now())

  // Passenger Details
  guestDetails Json?

  // Statuses
  bookingStatus BookingStatus @default(PENDING)

  // Payment Info
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  paymentTime   DateTime?
  paymentId     String?
  transactionId String?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  UPI
  NET_BANKING
  OFFLINE
  UNKNOWN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==========================================
// 5. REVIEW MODEL
// ==========================================
model Review {
  reviewId String @id @default(uuid())
  userId   String

  tourName   String
  reviewText String
  rating     Int
  photoUrl   String?
  createdAt  DateTime @default(now())

  // Relation
  user User @relation(fields: [userId], references: [userId])
}

// ==========================================
// 6. SYSTEM SETTINGS MODEL
// ==========================================

model SystemSettings {
  id           String @id @default("global_settings") // Hardcoded ID ensuring only 1 row
  siteName     String @default("DD Tours & Travels")
  supportEmail String @default("support@ddtours.com")
  supportPhone String @default("+91-9876543210")
  currency     String @default("INR")
  taxRate      Float  @default(18.0) // GST %

  updatedAt DateTime @updatedAt
}

// ==========================================
// 7. BLOG MODEL
// ==========================================

model Blog {
  id      String  @id @default(uuid())
  title   String
  slug    String  @unique
  content String  @db.Text
  excerpt String? @db.Text

  // Media
  coverImage String?
  images     String[]

  // 🆕 NEW VIDEO FIELDS
  youtubeUrl  String? // Optional: https://youtu.be/...
  facebookUrl String? // Optional: https://fb.watch/...

  category String
  tags     String[]
  authorId String

  isPublished Boolean @default(false)
  views       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [userId])
}
